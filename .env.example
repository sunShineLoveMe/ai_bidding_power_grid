# =========================================================
# AI 标书系统环境变量示例
# 复制为 .env 后按实际环境修改。不要提交真实 .env。
# =========================================================

# App / Security
APP_ENV=development
APP_HOST=127.0.0.1:3012
APP_PUBLIC_BASE_URL=http://127.0.0.1:3012
APP_CORS_ORIGINS=http://127.0.0.1:3012,http://localhost:3012,http://127.0.0.1:5173,http://localhost:5173
APP_LOCAL_ONLY=false
APP_AUTH_ENABLED=false
APP_AUTH_TOKEN=replace_with_a_random_token_at_least_24_chars
APP_EXPOSE_DEBUG_ERRORS=false
REQUIRE_STRICT_CONFIG=false
LOG_LEVEL=INFO
PORT=3012
FLASK_DEBUG=false

# Upload validation
MAX_UPLOAD_MB=200
UPLOAD_DIR=uploads/
OUTPUT_DIR=outputs/
ALLOWED_TENDER_EXTENSIONS=pdf,doc,docx,txt,md
ALLOWED_KNOWLEDGE_EXTENSIONS=pdf,doc,docx,txt,md,xls,xlsx,csv,png,jpg,jpeg,webp
ALLOWED_ASSET_EXTENSIONS=png,jpg,jpeg,webp,pdf,doc,docx

# LLM / Embedding / Rerank
# 标书写作模型默认使用 DeepSeek；知识库向量与 Rerank 默认仍使用 DashScope。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_INTERPRETATION_MODEL=deepseek-v4-pro
DEEPSEEK_INTERPRETATION_SEGMENT_MODEL=deepseek-v4-flash
DEEPSEEK_OUTLINE_MODEL=deepseek-v4-pro
DEEPSEEK_COMPLIANCE_MODEL=deepseek-v4-pro
DEEPSEEK_SECTION_WRITING_MODEL=deepseek-v4-flash
DEEPSEEK_SECTION_SUPPLEMENT_MODEL=deepseek-v4-flash
DEEPSEEK_KNOWLEDGE_MODEL=deepseek-v4-flash
DEEPSEEK_KNOWLEDGE_FOLLOWUP_MODEL=deepseek-v4-flash
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_MODEL=qwen-turbo-latest
DASHSCOPE_KNOWLEDGE_MODEL=qwen-long
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=1024
# Embedding 服务地址与密钥（OpenAI 兼容协议）。
# 默认走百炼；百炼额度用尽时可指向本地 Ollama 等开源向量服务。
#   - 百炼（默认）：EMBEDDING_BASE_URL 留空或设为 https://dashscope.aliyuncs.com/compatible-mode/v1
#   - 本地 Ollama：EMBEDDING_BASE_URL=http://localhost:11434/v1（后端在容器内时用 http://host.docker.internal:11434/v1）
#                  并设 DASHSCOPE_EMBEDDING_MODEL=qwen3-embedding:0.6b（输出 1024 维，与 pgvector schema 对齐）
# 换 embedding 模型/维度后必须全量重嵌（旧向量与新模型不在同一空间），详见 README。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
DASHSCOPE_RERANK_ENABLED=true
DASHSCOPE_RERANK_MODEL=qwen3-rerank
DASHSCOPE_RERANK_TOP_N=6
DASHSCOPE_REQUEST_TIMEOUT_SECONDS=120
REASONING_REQUEST_TIMEOUT_SECONDS=300
INTERPRETATION_SEGMENT_MAX_CHARS=24000
INTERPRETATION_SEGMENT_MAX_GROUPS=24
DASHSCOPE_STREAM_CONNECT_TIMEOUT_SECONDS=15
DASHSCOPE_STREAM_READ_TIMEOUT_SECONDS=180
DASHSCOPE_MAX_RETRIES=2
DASHSCOPE_RETRY_BASE_DELAY_SECONDS=1.5
DASHSCOPE_RETRY_MAX_DELAY_SECONDS=12
DASHSCOPE_RETRY_STATUS_CODES=429,500,502,503,504
AI_USAGE_USD_TO_CNY_RATE=7.2

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_TENDER_BUCKET=tender-files
SUPABASE_STORAGE_GENERATED_BUCKET=generated-docx
SUPABASE_STORAGE_KNOWLEDGE_BUCKET=knowledge-files
SUPABASE_STORAGE_QUALIFICATION_BUCKET=qualification-files
SUPABASE_STORAGE_PRODUCT_BUCKET=product-files

# PostgreSQL / Object Storage migration target
# 本地 Docker PostgreSQL 默认端口映射见 docker-compose.yml。
DB_PROVIDER=postgres
DATABASE_URL=postgresql://bidding:bidding_local_dev@127.0.0.1:15432/bidding
# PostgreSQL 连接池：web 与 celery-worker 每个进程各自维护本地池。
# 建议按 RDS max_connections、gunicorn workers、CELERY_WORKER_CONCURRENCY 反推上限。
POSTGRES_POOL_ENABLED=true
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_POOL_TIMEOUT_SECONDS=5
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=storage

# Redis / Celery 任务队列（P1-1）
# 容器内 backend / celery-worker 由 docker-compose 注入 redis://redis:6379/0。
# 本地裸跑 gunicorn 或 celery worker 时，需先 `docker compose up -d redis`，
# 再用下面这行连本机映射端口（compose 将 redis 暴露在宿主机 16379）。
REDIS_URL=redis://127.0.0.1:16379/0
# Celery worker 并发度；按 RDS 最大连接数和 ECS 规格设置上限，避免打满数据库连接。
CELERY_WORKER_CONCURRENCY=4
# 全文编写时并行编写的章节数（恢复历史"多路 DeepSeek 同时编写"）。
# 实际并行度 = min(SECTION_GEN_CONCURRENCY, CELERY_WORKER_CONCURRENCY)；
# 调高可提速，但需注意 DeepSeek 并发配额（429 限流）。默认 3。
SECTION_GEN_CONCURRENCY=3
# Celery 每个 worker 进程预取任务数。本项目章节生成耗时长，保持 1 可避免
# worker 一次性抢占大量章节，影响任务取消、续跑和演示可见性。
CELERY_WORKER_PREFETCH_MULTIPLIER=1
# 演示或快速首版生成时可设为 false，跳过章节自动扩写/补写，先产出可编辑正文。
BID_SECTION_LENGTH_SUPPLEMENT_ENABLED=true
# 章节达到目标字数的该比例后主动保存，避免流式接口迟迟不结束导致卡在 98%。
# 演示环境建议 0.18-0.35；生产环境可调回 0.95。
BID_SECTION_EARLY_SAVE_RATIO=0.18
# 测试/CI 设为 true 可让 Celery 任务同步执行（eager 模式），无需独立 worker。
CELERY_TASK_ALWAYS_EAGER=false
# 解析状态存储后端（P1-1 第二批）：db=写 PostgreSQL bid_parse_tasks（多进程/多容器可见，推荐）；
# file=写本地 parsed_outputs/{id}/mineru_status.json（仅单机调试）。
PARSE_STATUS_BACKEND=db
# OSS is optional. Keep STORAGE_PROVIDER=local for local development.
# STORAGE_PROVIDER=oss
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OSS_PUBLIC_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY_ID=your_oss_access_key_id
# OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
# OSS_BUCKET=your-private-bucket
# OSS_KEY_PREFIX=ai-bid/test
# OSS_SIGNED_URL_EXPIRES=3600

# Single-enterprise login for MVP.
APP_LOGIN_ENABLED=true
APP_SESSION_SECRET=replace_with_a_strong_session_secret
APP_SESSION_EXPIRES_HOURS=72
APP_COOKIE_SECURE=false

# DOCX export image controls
DOCX_MAX_IMAGES=24
DOCX_TOTAL_ASSET_IMAGE_LIMIT=36
DOCX_TECHNICAL_SECTION_IMAGE_LIMIT=2
DOCX_QUALIFICATION_SECTION_IMAGE_LIMIT=2
DOCX_BUSINESS_SECTION_IMAGE_LIMIT=1
DOCX_ATTACHMENT_SECTION_IMAGE_LIMIT=2
DOCX_OTHER_SECTION_IMAGE_LIMIT=1
DOCX_ALLOW_REMOTE_IMAGES=false

# DOCX export field refresh / LibreOffice headless
# 作用：后端导出 DOCX 后调用 soffice 重新保存一次，刷新目录页码、页脚页码和总页数。
# macOS Apple Silicon 通常为 /opt/homebrew/bin/soffice；Linux 通常为 /usr/bin/soffice。
# Docker Compose 容器内默认使用 /usr/bin/soffice，如需覆盖请设置 CONTAINER_SOFFICE_BIN。
DOCX_REFRESH_FIELDS=true
SOFFICE_BIN=/opt/homebrew/bin/soffice
CONTAINER_SOFFICE_BIN=/usr/bin/soffice
DOCX_REFRESH_TIMEOUT_SECONDS=180

# MinerU / OCR, optional
MINERU_API_TOKEN=your_mineru_api_token
MINERU_API_BASE_URL=https://mineru.net
MINERU_PARSE_PDF_FIRST=true
MINERU_DOWNLOAD_AUTO_RETRIES=6
MINERU_DOWNLOAD_RETRY_STALE_SECONDS=120
MINERU_DOWNLOAD_RESUME=true
MINERU_DOWNLOAD_KEEP_PARTIAL=true
MINERU_DOWNLOAD_USE_CURL_FALLBACK=true
MINERU_DOWNLOAD_DOH_RESOLVE=true

# Local data paths
BACKUP_DIR=backups/
WORD_TEMPLATE_PATH=templates/default_bid_template.docx

# ONLYOFFICE, optional
ONLYOFFICE_DOCS_API_URL=http://127.0.0.1:8080/web-apps/apps/api/documents/api.js
ONLYOFFICE_DOCUMENT_SERVER_URL=http://127.0.0.1:8080
ONLYOFFICE_JWT_SECRET=replace_with_a_strong_secret
BACKEND_URL_FOR_DOCKER=host.docker.internal:3012

# Enterprise profile, optional. Can also be maintained in Settings UI.
ENTERPRISE_NAME=某电力工程服务企业
ENTERPRISE_REGION=华北地区
ENTERPRISE_INDUSTRY=电力工程建设、设备供货、运维检修与技术服务
ENTERPRISE_BUSINESS_SCOPE=输变电工程、配网工程、电力设备供货、安装调试、试验检测、运维检修、技术服务和项目交付保障
ENTERPRISE_ADVANTAGES=具备电力项目响应、质量安全管理、设备供应链协同、现场施工组织、调试试验、运维服务和资料交付能力
ENTERPRISE_TARGET_CUSTOMERS=国家电网、南方电网、发电集团、电力建设单位、工业园区和能源类企业
ENTERPRISE_RESPONSE_STYLE=专业、严谨、合规、可落地；不得编造资质证书编号、人员姓名、业绩合同金额、具体日期和未提供的企业证明材料
